<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Features>$(Features);runtime-async=on</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Packaging. The native cdylib ships as a RID-specific asset, the same
       shape LibGit2.Native uses for git2.dll. Declared up front so the
       layout never has to be retrofitted. -->
  <PropertyGroup>
    <PackageId>GixSharp</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Description>Managed .NET bindings over gitoxide (gix), with interoptopus-generated native interop.</Description>
    <!-- Keep documentation output disabled while the generated public interop
         surface lacks XML comments. The managed layer is documented inline. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Package carries native code and is therefore RID-specific. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GixSharp.Tests" />
  </ItemGroup>

  <!-- Generated bindings. Not editable by hand: they are regenerated by the
       generate_bindings test in the gix-ffi crate, into namespace GixSharp. -->
  <ItemGroup>
    <Compile Include="../Interop.cs" Link="Generated/Interop.cs" />
  </ItemGroup>

  <PropertyGroup>
    <GixFfiRid Condition="'$(GixFfiRid)' == ''">win-x64</GixFfiRid>
    <GixFfiCrateDir>$(MSBuildProjectDirectory)/../..</GixFfiCrateDir>
    <GixFfiLibName Condition="$([MSBuild]::IsOsPlatform('Windows'))">gix_ffi.dll</GixFfiLibName>
    <GixFfiLibName Condition="$([MSBuild]::IsOsPlatform('Linux'))">libgix_ffi.so</GixFfiLibName>
    <GixFfiLibName Condition="$([MSBuild]::IsOsPlatform('OSX'))">libgix_ffi.dylib</GixFfiLibName>
    <GixFfiProfile Condition="'$(Configuration)' == 'Release'">release</GixFfiProfile>
    <GixFfiProfile Condition="'$(GixFfiProfile)' == ''">debug</GixFfiProfile>
    <GixFfiBuilt>$(GixFfiCrateDir)/target/$(GixFfiProfile)/$(GixFfiLibName)</GixFfiBuilt>
    <GixFfiStaged>$(MSBuildProjectDirectory)/runtimes/$(GixFfiRid)/native/$(GixFfiLibName)</GixFfiStaged>
  </PropertyGroup>

  <!-- Build the cdylib. Skippable with SkipCargoBuild=true so CI can build
       the native asset separately and just consume it. -->
  <Target Name="BuildGixFfi"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipCargoBuild)' != 'true'">
    <Message Importance="high" Text="cargo build ($(GixFfiProfile)) in $(GixFfiCrateDir)" />
    <Exec Command="cargo build" WorkingDirectory="$(GixFfiCrateDir)"
          Condition="'$(GixFfiProfile)' == 'debug'" />
    <Exec Command="cargo build --release" WorkingDirectory="$(GixFfiCrateDir)"
          Condition="'$(GixFfiProfile)' == 'release'" />
  </Target>

  <Target Name="StageGixFfi"
          AfterTargets="BuildGixFfi"
          BeforeTargets="AssignTargetPaths">
    <Error Condition="!Exists('$(GixFfiBuilt)')"
           Text="Native library not found at $(GixFfiBuilt). Run cargo build in $(GixFfiCrateDir), or set SkipCargoBuild=true and stage it yourself." />
    <Copy SourceFiles="$(GixFfiBuilt)"
          DestinationFiles="$(GixFfiStaged)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Staged asset flows to both the build output and the package. -->
  <ItemGroup>
    <None Include="runtimes/**/native/*"
          Pack="true"
          PackagePath="runtimes"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
